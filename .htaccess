# Enable Apache rewrite engine
RewriteEngine On
RewriteBase /sarkari/

# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Listing pages (extension-less)
RewriteRule ^jobs$ jobs.php [L,QSA]
RewriteRule ^results$ results.php [L,QSA]
RewriteRule ^admit$ admit.php [L,QSA]
RewriteRule ^syllabus$ syllabus.php [L,QSA]
RewriteRule ^posts$ posts.php [L,QSA]

# Detail pages by slug
RewriteRule ^job/([^/]+)$ job.php?slug=$1 [L,QSA]
RewriteRule ^result/([^/]+)$ result.php?slug=$1 [L,QSA]
RewriteRule ^admit/([^/]+)$ admit-detail.php?slug=$1 [L,QSA]
RewriteRule ^author/([^/]+)$ author.php?slug=$1 [L,QSA]
RewriteRule ^syllabus/([^/]+)$ syllabus-detail.php?slug=$1 [L,QSA]
RewriteRule ^post/([^/]+)$ post.php?slug=$1 [L,QSA]

# Categories under jobs
RewriteRule ^jobs/([^/]+)$ jobs.php?category=$1 [L,QSA]

# -------------------------------
# Performance: compression & caching
# -------------------------------

# Brotli (if available)
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS \
    text/html text/plain text/xml text/css \
    application/javascript application/json application/xml \
    image/svg+xml
</IfModule>

# Gzip fallback (if Brotli unavailable)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html text/plain text/xml text/css \
    application/javascript application/json application/xml \
    image/svg+xml
</IfModule>

# Far-future caching for static assets (use cache-busting filenames on deploy)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 1 month"
</IfModule>

# Cache-Control headers for immutable static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|png|jpe?g|gif|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:xml|json|txt|html|htm)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

# Correct MIME types
AddType image/webp .webp
AddType image/svg+xml .svg
