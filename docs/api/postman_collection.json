              {"key": "q", "value": "railway"},
              {"key": "category", "value": "bank"}
            ]}
          }
        },
        {
          "name": "Job Detail",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
